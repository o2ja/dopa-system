# Install: sudo cp deploy/dopa-web.service /etc/systemd/system/ && sudo systemctl daemon-reload
#          sudo systemctl enable --now dopa-web
# Edit User, WorkingDirectory and the node path (`which node`) first. Secrets go in <app>/.env.
[Unit]
Description=Dopa web (Next.js)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=dopa
WorkingDirectory=/var/www/dopa_system
Environment=NODE_ENV=production
EnvironmentFile=/var/www/dopa_system/.env
ExecStart=/usr/bin/node node_modules/next/dist/bin/next start -p 3000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
