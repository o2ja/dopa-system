# Prisma connection string (SQLite locally; use a postgresql/mysql URL in production)
DATABASE_URL="file:./dev.db"

# Shared password for /pos, /admin and their APIs. REQUIRED in production:
# if empty or unset, those areas are open to everyone (local dev only).
# Changing it logs every staff device out.
STAFF_PASSWORD=

# Shared with every print-bridge (its BRIDGE_SECRET must match). Unset = bridges are rejected.
BRIDGE_SECRET=
