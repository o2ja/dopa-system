# Local dev DB: `docker compose up -d db` (published on 127.0.0.1:5433). Docker web service ignores this value.
DATABASE_URL="postgresql://dopa:dopa@localhost:5433/dopa"
POSTGRES_PASSWORD=dopa

# Signs staff sessions and peppers PIN hashes. REQUIRED in production (any long random string).
# Changing it invalidates every PIN: reseed staff afterwards.
AUTH_SECRET=

# Shared with every print-bridge (its BRIDGE_SECRET must match). Unset = bridges are rejected.
BRIDGE_SECRET=

# Optional: PIN for the seeded SUPER_ADMIN (4-6 digits). Default 9999 is for testing only.
OWNER_PIN=
