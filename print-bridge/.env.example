# Base URL of the Dopa Next.js server, reachable from this machine
API_BASE_URL=http://localhost:3000

# This branch: slug (e.g. branch-1) or id
BRANCH_ID=branch-1

# Must equal BRIDGE_SECRET in the server's .env
BRIDGE_SECRET=change-me

# true = write previews to ./debug-receipts/ instead of printing
DRY_RUN=true

# Optional: override the printer IPs set in Admin > Branches. Leave empty to use the admin values.
COFFEE_PRINTER_IP=
KITCHEN_PRINTER_IP=
PIZZA_PRINTER_IP=
CASHIER_PRINTER_IP=
